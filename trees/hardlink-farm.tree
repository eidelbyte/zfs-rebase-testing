title hardlink farm: a dedup backup tree that merges without a fight

# A backup server.  /srv/backup/store is content-addressed storage and
# the daily, weekly and monthly folders are views that hard-link into
# it, so nearly every dnode here wears two or three names.  This is the
# example to open the inspector on: the face diagram is dense with
# green (shared names) and red (dnode identity) at once.
#
# Five separate mechanisms fire, and all five are clean:
#
#   - a double rename on a hard-linked pair (dnode 10).  Onto renames
#     the daily name, off-of renames the weekly name.  Succession reads
#     each new name through its antecedent, the base co-pooling is
#     severed by nobody, so link L1 holds the pair together and the
#     file comes out with two names again instead of splitting in two.
#   - a grow (dnode 11).  Off-of hard-links a third name into a pool
#     onto left alone; the new name is an attachment, L3 joins it to
#     the pool, no exclusion opposes it.
#   - a grow from both sides at once (dnode 30).  Two attachments, two
#     L3 links, one pool.
#   - an identical merge (dnodes 20 and 21).  Both sides dedup sha-bbb
#     onto sha-aaa's dnode.  Pass 3's agreement short-circuit sees the
#     two sides holding yellow-equal pools and takes that content
#     rather than asking the multi-parent rule to referee it.
#   - a swapfile-style dnode churn (dnode 22 -> 322).  Off-of rewrote
#     swap.img through a temp file, so the name kept its place and
#     changed its dnode; K2 pairing survives that and the new bytes
#     are taken.
#
# Around them sit the ordinary things: pools nobody touched (index.txt
# under three names, archive.bin under two) and one edit to
# config/backup.conf that only onto made.

tree base
  1-1: /
    2-100: srv/
      3-100: backup/
        4-100: daily/
          10-100: db.dump = db-aug01
          11-100: home.tar = home-aug01
          12-100: index.txt = index-v1
          23-100: archive.bin
        5-100: weekly/
          10-100: db.dump
          11-100: home.tar
          12-100: index.txt
        6-100: monthly/
          13-100: db.dump = db-jul01
          12-100: index.txt
        7-100: store/
          20-100: sha-aaa = blob-a
          21-100: sha-bbb = blob-a
          22-100: swap.img = swap-v0
          23-100: sha-ddd = blob-d
          24-100: sha-eee = blob-e
          30-100: sha-ccc = blob-c
        8-100: config/
          25-100: backup.conf = conf-v1
          26-100: exclude.list = excl-v1

tree onto
  1-1: /
    2-100: srv/
      3-100: backup/
        4-100: daily/
          # half of the double rename: db.dump -> db.sql, daily side.
          10-100: db.sql = db-aug01
          11-100: home.tar = home-aug01
          12-100: index.txt = index-v1
          23-100: archive.bin
          # onto's half of the two-sided grow on dnode 30.
          30-100: blob.bin = blob-c
        5-100: weekly/
          10-100: db.dump
          11-100: home.tar
          12-100: index.txt
        6-100: monthly/
          13-100: db.dump = db-jul01
          12-100: index.txt
        7-100: store/
          # the dedup: sha-bbb is now a second name for sha-aaa's dnode.
          20-100: sha-aaa = blob-a
          20-100: sha-bbb
          22-100: swap.img = swap-v0
          23-100: sha-ddd = blob-d
          24-100: sha-eee = blob-e
          30-100: sha-ccc
        8-100: config/
          # a plain edit off-of never touched.
          25-100: backup.conf = conf-v2
          26-100: exclude.list = excl-v1

tree offof
  1-1: /
    2-100: srv/
      3-100: backup/
        4-100: daily/
          10-100: db.dump = db-aug01
          11-100: home.tar = home-aug01
          12-100: index.txt = index-v1
          23-100: archive.bin
        5-100: weekly/
          # the other half of the double rename, weekly side.
          10-100: db.sql
          11-100: home.tar
          12-100: index.txt
          # off-of's half of the two-sided grow on dnode 30.
          30-100: blob.bin = blob-c
        6-100: monthly/
          13-100: db.dump = db-jul01
          12-100: index.txt
          # the one-sided grow: a third link to the August home tarball.
          11-100: home.tar
        7-100: store/
          # off-of performed the identical dedup, independently.
          20-100: sha-aaa = blob-a
          20-100: sha-bbb
          # the swapfile save: same name, fresh dnode, new bytes.
          322-300: swap.img = swap-v1
          23-100: sha-ddd = blob-d
          24-100: sha-eee = blob-e
          30-100: sha-ccc
        8-100: config/
          25-100: backup.conf = conf-v1
          26-100: exclude.list = excl-v1

# --- expected result, generated by gen-expected.js ---
expect clean

tree expected
  1-1: /
    2-100: srv
      3-100: backup
        8-100: config
          25-100: backup.conf = conf-v2
          26-100: exclude.list = excl-v1
        4-100: daily
          23-100: archive.bin = blob-d
          30-100: blob.bin = blob-c
          10-100: db.sql = db-aug01
          11-100: home.tar = home-aug01
          12-100: index.txt = index-v1
        6-100: monthly
          13-100: db.dump = db-jul01
          11-100: home.tar
          12-100: index.txt
        7-100: store
          20-100: sha-aaa = blob-a
          20-100: sha-bbb
          30-100: sha-ccc
          23-100: sha-ddd
          24-100: sha-eee = blob-e
          22-100: swap.img = swap-v1
        5-100: weekly
          30-100: blob.bin
          10-100: db.sql
          11-100: home.tar
          12-100: index.txt

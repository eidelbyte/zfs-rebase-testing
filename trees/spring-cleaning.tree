title spring cleaning: one big reorganization, one quiet substrate

# The unilateral case at scale.
#
# Off-of spends an afternoon tidying a home directory: the document
# folder is broken into subfolders file by file, the photo library
# gains a year folder, a hard-linked pair of notes is split into two
# independent files, three files are thrown away, one new file is
# written, and the shell profile is edited.  None of that is opposed:
# onto only edited /etc/rc.conf and /var/log/messages, which off-of
# never touched.
#
# Proposition 10.1 (fidelity) says the answer here is not a
# compromise.  Every component is unilateral, so every component
# decides to the exact state of whichever side moved it, and the two
# sides' work simply lands side by side.  Zero conflicts, and the
# reorganized home directory comes out shaped the way off-of shaped
# it while onto's two edits stay put.
#
# Numbering convention used in all four examples: dnodes born before
# the split carry txg 100, dnodes onto allocates carry txg 200 and an
# index of 2xx, dnodes off-of allocates carry txg 300 and an index of
# 3xx.  Repeating one idx-txg on two lines of a tree is a hard link.

tree base
  1-1: /
    2-100: etc/
      3-100: rc.conf = rc-v1
      4-100: hosts = hosts-v1
    5-100: home/
      6-100: user/
        7-100: docs/
          8-100: taxes-2024.txt = taxes24-v1
          9-100: taxes-2025.txt = taxes25-v1
          10-100: recipe.txt = recipe-v1
          11-100: draft.txt = draft-v1
        12-100: notes/
          # one file, two names: the notes and their hard-linked backup.
          13-100: todo.txt = todo-v1
          13-100: todo-backup.txt
          15-100: scratch.txt = scratch-v1
        16-100: photos/
          17-100: img001.jpg = jpeg-beach
          18-100: img002.jpg = jpeg-cake
          19-100: img003.jpg = jpeg-blur
        14-100: .shrc = shrc-v1
        20-100: .profile = profile-v1
    21-100: var/
      22-100: log/
        23-100: messages = log-v1

tree onto
  # Onto is the quiet side.  It rewrote one configuration file and the
  # log grew; nothing under /home was touched, so every name off-of
  # moved is home in onto and pass 1 adopts off-of's arrangement of it.
  1-1: /
    2-100: etc/
      3-100: rc.conf = rc-v2
      4-100: hosts = hosts-v1
    5-100: home/
      6-100: user/
        7-100: docs/
          8-100: taxes-2024.txt = taxes24-v1
          9-100: taxes-2025.txt = taxes25-v1
          10-100: recipe.txt = recipe-v1
          11-100: draft.txt = draft-v1
        12-100: notes/
          13-100: todo.txt = todo-v1
          13-100: todo-backup.txt
          15-100: scratch.txt = scratch-v1
        16-100: photos/
          17-100: img001.jpg = jpeg-beach
          18-100: img002.jpg = jpeg-cake
          19-100: img003.jpg = jpeg-blur
        14-100: .shrc = shrc-v1
        20-100: .profile = profile-v1
    21-100: var/
      22-100: log/
        23-100: messages = log-v2

tree offof
  # The afternoon of tidying.
  1-1: /
    2-100: etc/
      3-100: rc.conf = rc-v1
      4-100: hosts = hosts-v1
    5-100: home/
      6-100: user/
        7-100: docs/
          # Two new folders, and the four documents moved into them one
          # at a time.  Each moved file keeps its dnode and changes its
          # name, so red pairs it with base and the cell simply adopts
          # the new name.
          301-300: food/
            10-100: recipe.txt = recipe-v1
          302-300: tax/
            8-100: taxes-2024.txt = taxes24-v1
            9-100: taxes-2025.txt = taxes25-v1
          # draft.txt (11-100) is gone.
        12-100: notes/
          303-300: ideas.txt = ideas-v1
          # The hard link is broken: todo-backup.txt keeps the same
          # bytes on a dnode of its own.  Off-of severs the pair, onto
          # asserts no link over it, so the two names come out as two
          # pools (Definition 9.5).
          13-100: todo.txt = todo-v1
          310-300: todo-backup.txt = todo-v1
          # scratch.txt (15-100) is gone.
        16-100: photos/
          304-300: 2024/
            17-100: beach.jpg = jpeg-beach
            18-100: cake.jpg = jpeg-cake
          # img003.jpg (19-100) was blurry and is gone.
        14-100: .shrc = shrc-v1
        20-100: .profile = profile-v2
    21-100: var/
      22-100: log/
        23-100: messages = log-v1

# --- expected result, generated by gen-expected.js ---
expect clean

tree expected
  1-1: /
    2-100: etc
      4-100: hosts = hosts-v1
      3-100: rc.conf = rc-v2
    5-100: home
      6-100: user
        20-100: .profile = profile-v2
        14-100: .shrc = shrc-v1
        7-100: docs
          9000-9000: food
            10-100: recipe.txt = recipe-v1
          9001-9000: tax
            8-100: taxes-2024.txt = taxes24-v1
            9-100: taxes-2025.txt = taxes25-v1
        12-100: notes
          9002-9000: ideas.txt = ideas-v1
          13-100: todo-backup.txt = todo-v1
          9003-9000: todo.txt = todo-v1
        16-100: photos
          9004-9000: 2024
            17-100: beach.jpg = jpeg-beach
            18-100: cake.jpg = jpeg-cake
    21-100: var
      22-100: log
        23-100: messages = log-v2
